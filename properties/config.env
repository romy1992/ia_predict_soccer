# APP_LEAGUES=135,136,137,138,942,943,140,144,78,61,39,94,203,88,492,2,3,848
# APP_SEASONS=2026
# OPS-01: scheduler con job separati (data jobs frequenti, training job
# indipendente - MAI un retrain automatico ad ogni import). Tutti opzionali,
# i default sono nel codice (`src/service_ia/config/app_config.py`).
# Data job "fixture odierne" (NS/live/final), in minuti:
# DATA_SYNC_INTERVAL_MINUTES=30
# Data job "settlement" (riconciliazione partite concluse), in minuti:
# SETTLEMENT_INTERVAL_MINUTES=60
# Data job "future sync" (fixture future), cron giornaliero:
# FUTURE_SYNC_HOUR=4
# FUTURE_SYNC_MINUTE=30
# Training job (retrain modelli ML), cron giornaliero INDIPENDENTE dai data
# job - TRAINING_HOUR/TRAINING_MINUTE hanno la precedenza; SCHEDULER_HOUR/
# SCHEDULER_MINUTE restano supportati come fallback legacy:
# TRAINING_HOUR=23
# TRAINING_MINUTE=0
# SCHEDULER_HOUR=23
# SCHEDULER_MINUTE=0
# LIVE-01: pipeline dati live SEPARATA (fixtures/eventi/statistiche in
# tempo reale), job "data_sync_live" indipendente dagli altri data job:
# intervallo di polling in SECONDI (le partite live cambiano stato molto
# piu' spesso delle fixture odierne, per cui l'unita' non e' in minuti):
# LIVE_SYNC_INTERVAL_SECONDS=90
# TTL della cache interna del provider live (secondi), sempre <= intervallo
# di polling per evitare di servire dati live stantii:
# LIVE_CACHE_TTL_SECONDS=20
